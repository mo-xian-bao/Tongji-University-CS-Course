EXPLAIN (COSTS OFF)
INSERT INTO TMP_CSUM_1
  (ACCNO,
   TIMESTMP,
   BANK_FLAG,
   AMOUNT,
   AMOUNTSUM,
   LOANBAL,
   Etl_Tx_Dt)
SELECT ACCNO, TIMESTMP, BANK_FLAG, AMOUNT, SUM(AMOUNT) OVER(PARTITION BY ACCNO ORDER BY ACCNO, TIMESTMP ROWS UNBOUNDED PRECEDING), LOANBAL, to_date('20141231', 'YYYYMMDD') FROM LOAN_DPSIT_ACCT_EVENT_INFO;
                                                QUERY PLAN                                                 
-----------------------------------------------------------------------------------------------------------
 Streaming (type: GATHER)
   Node/s: All datanodes
   ->  Insert on tmp_csum_1
         ->  Subquery Scan on "*SELECT*"
               ->  WindowAgg
                     ->  Sort
                           Sort Key: loan_dpsit_acct_event_info.accno, loan_dpsit_acct_event_info.timestmp
                           ->  Seq Scan on loan_dpsit_acct_event_info
(8 rows)

EXPLAIN (COSTS OFF)
INSERT INTO COL_TENK1
SELECT FOUR, TEN,
	SUM(TEN) OVER (PARTITION BY FOUR ORDER BY TEN RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
	LAST_VALUE(TEN) OVER (PARTITION BY FOUR ORDER BY TEN RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM (SELECT DISTINCT TEN, FOUR FROM TENK1) SS ORDER BY 1, 2, 3, 4;
                                                                                                                                                            QUERY PLAN                                                                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   ->  Vector Streaming (type: GATHER)
         Node/s: All datanodes
         ->  Vector Insert on col_tenk1
               ->  Vector Adapter
                     ->  Subquery Scan on "*SELECT*"
                           ->  Sort
                                 Sort Key: ss.four, ss.ten, (sum(ss.ten) OVER (PARTITION BY ss.four ORDER BY ss.ten USING = NULLS LAST RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)), (last_value(ss.ten) OVER (PARTITION BY ss.four ORDER BY ss.ten USING = NULLS LAST RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW))
                                 ->  WindowAgg
                                       ->  Sort
                                             Sort Key: ss.four, ss.ten
                                             ->  Subquery Scan on ss
                                                   ->  HashAggregate
                                                         Group By Key: vector_window_engine.tenk1.ten, vector_window_engine.tenk1.four
                                                         ->  Streaming(type: REDISTRIBUTE)
                                                               Spawn on: All datanodes
                                                               ->  HashAggregate
                                                                     Group By Key: vector_window_engine.tenk1.ten, vector_window_engine.tenk1.four
                                                                     ->  Result
                                                                           ->  Append
                                                                                 ->  Row Adapter
                                                                                       ->  Dfs Scan on tenk1
                                                                                 ->  Seq Scan on pg_delta_vector_window_engine_tenk1 tenk1
(23 rows)

