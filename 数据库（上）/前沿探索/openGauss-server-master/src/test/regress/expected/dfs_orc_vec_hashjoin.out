reset work_mem;
----
--- ICBC Case: HashJoin with case--when expression 
----
CREATE TABLE vector_hashjoin_engine.MF1_PTHNFSUB(
	STATUS DECIMAL(1,0),
	VALUEDAY DATE)with(orientation = orc) tablespace hdfs_ts ;
CREATE TABLE vector_hashjoin_engine.MF1_NTHPARAT(  
	CURRTYPE DECIMAL(3,0),
	RATECODE DECIMAL(1,0),
	Etl_Tx_Dt DATE) with(orientation = orc) tablespace hdfs_ts ;
insert into vector_hashjoin_engine.MF1_PTHNFSUB values(4, '2014-12-19');
insert into vector_hashjoin_engine.MF1_PTHNFSUB values(1, '2014-10-19');
insert into vector_hashjoin_engine.MF1_PTHNFSUB values(2, '2014-08-19');
insert into vector_hashjoin_engine.MF1_PTHNFSUB values(3, '2014-02-09');
insert into vector_hashjoin_engine.MF1_NTHPARAT values (5, 4, '2014-12-19');
explain (verbose on, costs off) select 
	count(*) 
FROM 	
	vector_hashjoin_engine.MF1_PTHNFSUB T1  
LEFT JOIN 	
	vector_hashjoin_engine.MF1_NTHPARAT T2  
ON 	
	T2.CURRTYPE=1 
AND 	
	CASE WHEN CAST('20141231' AS DATE)-T1.VALUEDAY<=90 THEN substring('abcd', 1)                        	    
	     WHEN CAST('20141231' AS DATE)-T1.VALUEDAY>90 AND CAST('20141231' AS DATE)-T1.VALUEDAY<=180 THEN '0200300'                          	
	     WHEN CAST('20141231' AS DATE)-T1.VALUEDAY>180 AND CAST('20141231' AS DATE)-T1.VALUEDAY<=360 THEN trim('jjhh',4)                          	
	     ELSE '0201200'	
	END=lpad(T2.RATECODE, 7, '0');
                                                                                                                                                                                                                                                                                                                                                            QUERY PLAN                                                                                                                                                                                                                                                                                                                                                             
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: (pg_catalog.count(*))
   ->  Vector Aggregate
         Output: pg_catalog.count(*)
         ->  Vector Streaming (type: GATHER)
               Output: (count(*))
               Node/s: All datanodes
               ->  Vector Aggregate
                     Output: count(*)
                     ->  Vector Hash Right Join
                           Output: 'Dummy'
                           Hash Cond: (lpad((t2.ratecode)::text, 7, '0'::text) = CASE WHEN (('Wed Dec 31 00:00:00 2014'::timestamp(0) without time zone - t1.valueday) <= '@ 90 days'::interval) THEN 'abcd'::text WHEN ((('Wed Dec 31 00:00:00 2014'::timestamp(0) without time zone - t1.valueday) > '@ 90 days'::interval) AND (('Wed Dec 31 00:00:00 2014'::timestamp(0) without time zone - t1.valueday) <= '@ 180 days'::interval)) THEN '0200300'::text WHEN ((('Wed Dec 31 00:00:00 2014'::timestamp(0) without time zone - t1.valueday) > '@ 180 days'::interval) AND (('Wed Dec 31 00:00:00 2014'::timestamp(0) without time zone - t1.valueday) <= '@ 360 days'::interval)) THEN 'jjhh'::text ELSE '0201200'::text END)
                           ->  Vector Streaming(type: BROADCAST)
                                 Output: t2.ratecode
                                 Spawn on: datanode6
                                 Consumer Nodes: All datanodes
                                 ->  Vector Append
                                       ->  Dfs Scan on vector_hashjoin_engine.mf1_nthparat t2
                                             Output: t2.ratecode
                                             Distribute Key: t2.currtype
                                             Pushdown Predicate Filter: (t2.currtype = 1::numeric)
                                       ->  Vector Adapter
                                             Output: t2.ratecode
                                             ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_mf1_nthparat t2
                                                   Output: t2.ratecode
                                                   Distribute Key: t2.currtype
                                                   Filter: (t2.currtype = 1::numeric)
                           ->  Vector Append
                                 ->  Dfs Scan on vector_hashjoin_engine.mf1_pthnfsub t1
                                       Output: t1.valueday
                                       Distribute Key: t1.status
                                 ->  Vector Adapter
                                       Output: t1.valueday
                                       ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_mf1_pthnfsub t1
                                             Output: t1.valueday
                                             Distribute Key: t1.status
(36 rows)

select 
	count(*) 
FROM 	
	vector_hashjoin_engine.MF1_PTHNFSUB T1  
LEFT JOIN 	
	vector_hashjoin_engine.MF1_NTHPARAT T2  
ON 	
	T2.CURRTYPE=1 
AND 	
	CASE WHEN CAST('20141231' AS DATE)-T1.VALUEDAY<=90 THEN substring('abcd', 1)                        	    
	     WHEN CAST('20141231' AS DATE)-T1.VALUEDAY>90 AND CAST('20141231' AS DATE)-T1.VALUEDAY<=180 THEN '0200300'                          	
	     WHEN CAST('20141231' AS DATE)-T1.VALUEDAY>180 AND CAST('20141231' AS DATE)-T1.VALUEDAY<=360 THEN trim('jjhh',4)                          	
	     ELSE '0201200'	
	END=lpad(T2.RATECODE, 7, '0');
 count 
-------
     4
(1 row)

	
--test for semi join
set current_schema=vector_engine; 
explain (verbose on, costs off)  
SELECT    'COL' AS ETL_SERVER,
    D.ETL_SYSTEM,
    D.ETL_JOB
FROM ETL_JOB_DEPENDENCY D,ETL_JOB_PRIORITY P
WHERE D.ETL_JOB=P.ETL_JOB
AND D.ENABLE='1'
AND D.ETL_JOB IN (
SELECT NEXT_JOB FROM (SELECT NEXT_JOB
FROM (SELECT N2.*, D.DEPENDENCY_JOB AS NEXT_JOB_DEPENDENCY_JOB
FROM (SELECT N.DEPENDENCY_JOB  AS FINISHED_JOB,
    N.ETL_JOB         AS NEXT_JOB
FROM ETL_JOB_DEPENDENCY N
WHERE N.DEPENDENCY_JOB = 'MF1_PTHGKSUB_A'
AND N.ENABLE='1') N2
 left JOIN ETL_JOB_DEPENDENCY D ON (N2.NEXT_JOB = D.ETL_JOB AND D.ENABLE='1')) N3
 left JOIN ETL_JOB J2 ON (J2.ETL_JOB = N3.NEXT_JOB_DEPENDENCY_JOB AND J2.LAST_TXDATE = TO_DATE('2015-05-28 13:49:47','yyyy-mm-dd hh24:mi:ss'))
GROUP BY NEXT_JOB)
) order by 1,2,3;
                                                                                             QUERY PLAN                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: ('COL'::text), d.etl_system, d.etl_job
   ->  Vector Streaming (type: GATHER)
         Output: ('COL'::text), d.etl_system, d.etl_job
         Merge Sort Key: d.etl_system, d.etl_job
         Node/s: All datanodes
         ->  Vector Sort
               Output: ('COL'::text), d.etl_system, d.etl_job
               Sort Key: d.etl_system, d.etl_job
               ->  Vector Sonic Hash Join
                     Output: 'COL'::text, d.etl_system, d.etl_job
                     Hash Cond: ((d.etl_job)::text = (p.etl_job)::text)
                     ->  Vector Append
                           ->  Dfs Scan on vector_engine.etl_job_dependency d
                                 Output: d.etl_system, d.etl_job
                                 Distribute Key: d.etl_job
                                 Pushdown Predicate Filter: ((d.enable)::text = '1'::text)
                           ->  Vector Adapter
                                 Output: d.etl_system, d.etl_job
                                 ->  Seq Scan on cstore.pg_delta_vector_engine_etl_job_dependency d
                                       Output: d.etl_system, d.etl_job
                                       Distribute Key: d.etl_job
                                       Filter: ((d.enable)::text = '1'::text)
                     ->  Vector Sonic Hash Join
                           Output: p.etl_job, __unnamed_subquery__.next_job
                           Hash Cond: ((p.etl_job)::text = (__unnamed_subquery__.next_job)::text)
                           ->  Vector Append
                                 ->  Dfs Scan on vector_engine.etl_job_priority p
                                       Output: p.etl_job
                                       Distribute Key: p.etl_job
                                 ->  Vector Adapter
                                       Output: p.etl_job
                                       ->  Seq Scan on cstore.pg_delta_vector_engine_etl_job_priority p
                                             Output: p.etl_job
                                             Distribute Key: p.etl_job
                           ->  Vector Sonic Hash Aggregate
                                 Output: __unnamed_subquery__.next_job
                                 Group By Key: (__unnamed_subquery__.next_job)::text
                                 ->  Vector Subquery Scan on __unnamed_subquery__
                                       Output: __unnamed_subquery__.next_job, __unnamed_subquery__.next_job
                                       ->  Vector Sonic Hash Aggregate
                                             Output: n.etl_job
                                             Group By Key: n.etl_job
                                             ->  Vector Streaming(type: REDISTRIBUTE)
                                                   Output: n.etl_job
                                                   Distribute Key: n.etl_job
                                                   Spawn on: All datanodes
                                                   Consumer Nodes: All datanodes
                                                   ->  Vector Hash Left Join
                                                         Output: n.etl_job
                                                         Hash Cond: ((d.dependency_job)::text = (j2.etl_job)::text)
                                                         Skew Join Optimized by Rule
                                                         ->  Vector Streaming(type: PART REDISTRIBUTE PART LOCAL)
                                                               Output: n.etl_job, d.dependency_job
                                                               Distribute Key: d.dependency_job
                                                               Spawn on: All datanodes
                                                               Consumer Nodes: All datanodes
                                                               ->  Vector Hash Left Join
                                                                     Output: n.etl_job, d.dependency_job
                                                                     Hash Cond: ((n.etl_job)::text = (d.etl_job)::text)
                                                                     ->  Vector Append
                                                                           ->  Dfs Scan on vector_engine.etl_job_dependency n
                                                                                 Output: n.etl_job
                                                                                 Distribute Key: n.etl_job
                                                                                 Pushdown Predicate Filter: (((n.dependency_job)::text = 'MF1_PTHGKSUB_A'::text) AND ((n.enable)::text = '1'::text))
                                                                           ->  Vector Adapter
                                                                                 Output: n.etl_job
                                                                                 ->  Seq Scan on cstore.pg_delta_vector_engine_etl_job_dependency n
                                                                                       Output: n.etl_job
                                                                                       Distribute Key: n.etl_job
                                                                                       Filter: (((n.dependency_job)::text = 'MF1_PTHGKSUB_A'::text) AND ((n.enable)::text = '1'::text))
                                                                     ->  Vector Append
                                                                           ->  Dfs Scan on vector_engine.etl_job_dependency d
                                                                                 Output: d.etl_job, d.dependency_job
                                                                                 Distribute Key: d.etl_job
                                                                                 Pushdown Predicate Filter: ((d.enable)::text = '1'::text)
                                                                           ->  Vector Adapter
                                                                                 Output: d.etl_job, d.dependency_job
                                                                                 ->  Seq Scan on cstore.pg_delta_vector_engine_etl_job_dependency d
                                                                                       Output: d.etl_job, d.dependency_job
                                                                                       Distribute Key: d.etl_job
                                                                                       Filter: ((d.enable)::text = '1'::text)
                                                         ->  Vector Append
                                                               ->  Dfs Scan on vector_engine.etl_job j2
                                                                     Output: j2.etl_job
                                                                     Distribute Key: j2.etl_job
                                                                     Filter: (j2.last_txdate = to_date('2015-05-28 13:49:47'::text, 'yyyy-mm-dd hh24:mi:ss'::text))
                                                               ->  Vector Adapter
                                                                     Output: j2.etl_job
                                                                     ->  Seq Scan on cstore.pg_delta_vector_engine_etl_job j2
                                                                           Output: j2.etl_job
                                                                           Distribute Key: j2.etl_job
                                                                           Filter: (j2.last_txdate = to_date('2015-05-28 13:49:47'::text, 'yyyy-mm-dd hh24:mi:ss'::text))
