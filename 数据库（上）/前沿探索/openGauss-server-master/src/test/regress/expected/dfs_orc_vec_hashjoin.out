                                                       QUERY PLAN                                                        
-------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: b.c_int, a.c_bigint
   ->  Vector Streaming (type: GATHER)
         Output: b.c_int, a.c_bigint
         Merge Sort Key: b.c_int, a.c_bigint
         ->  Vector Sort
               Output: b.c_int, a.c_bigint
               Sort Key: b.c_int, a.c_bigint
               ->  Vector Hash Anti Join
                     Output: b.c_int, a.c_bigint
                     Hash Cond: (a.c_int = b.c_int)
                     ->  Vector Streaming(type: REDISTRIBUTE)
                           Output: a.c_bigint, a.c_int
                           Distribute Key: a.c_int
                           ->  Vector Append
                                 ->  Dfs Scan on vector_hashjoin_engine.vector_hashjoin_table_03 a
                                       Output: a.c_bigint, a.c_int
                                       Distribute Key: a.c_char_1
                                 ->  Vector Adapter
                                       Output: a.c_bigint, a.c_int
                                       ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_vector_hashjoin_table_03 a
                                             Output: a.c_bigint, a.c_int
                                             Distribute Key: a.c_char_1
                     ->  Vector Streaming(type: REDISTRIBUTE)
                           Output: b.c_int
                           Distribute Key: b.c_int
                           ->  Vector Append
                                 ->  Dfs Scan on vector_hashjoin_engine.vector_hashjoin_table_04 b
                                       Output: b.c_int
                                       Distribute Key: b.c_char_1
                                 ->  Vector Adapter
                                       Output: b.c_int
                                       ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_vector_hashjoin_table_04 b
                                             Output: b.c_int
                                             Distribute Key: b.c_char_1
