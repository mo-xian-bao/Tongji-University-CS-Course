set enable_nestloop=off;
set enable_mergejoin=off;
----
--- case 1: HashJoin Inner Join
----
explain (verbose on, costs off) SELECT A.C_INT, A.C_BIGINT, A.C_VARCHAR_3, A.C_DATE FROM VECTOR_HASHJOIN_TABLE_01 A INNER JOIN VECTOR_HASHJOIN_TABLE_02 B ON A.C_INT = B.C_INT WHERE A.C_INT <8  AND  A.C_BIGINT<9  ORDER BY 1, 2;
                                                       QUERY PLAN                                                        
-------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
   ->  Vector Streaming (type: GATHER)
         Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
         Merge Sort Key: a.c_int, a.c_bigint
         Node/s: All datanodes
         ->  Vector Sort
               Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
               Sort Key: a.c_int, a.c_bigint
               ->  Vector Sonic Hash Join
                     Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
                     Hash Cond: (a.c_int = b.c_int)
                     ->  Vector Streaming(type: REDISTRIBUTE)
                           Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
                           Distribute Key: a.c_int
                           Spawn on: All datanodes
                           Consumer Nodes: All datanodes
                           ->  Vector Append
                                 ->  Dfs Scan on vector_hashjoin_engine.vector_hashjoin_table_01 a
                                       Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
                                       Distribute Key: a.c_char_1
                                       Pushdown Predicate Filter: ((a.c_int < 8) AND (a.c_bigint < 9))
                                 ->  Vector Adapter
                                       Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
                                       ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_vector_hashjoin_table_01 a
                                             Output: a.c_int, a.c_bigint, a.c_varchar_3, a.c_date
                                             Distribute Key: a.c_char_1
                                             Filter: ((a.c_int < 8) AND (a.c_bigint < 9))
                     ->  Vector Append
                           ->  Dfs Scan on vector_hashjoin_engine.vector_hashjoin_table_02 b
                                 Output: b.c_int
                                 Distribute Key: b.c_int
                                 Pushdown Predicate Filter: (b.c_int < 8)
                           ->  Vector Adapter
                                 Output: b.c_int
                                 ->  Seq Scan on cstore.pg_delta_vector_hashjoin_engine_vector_hashjoin_table_02 b
                                       Output: b.c_int
                                       Distribute Key: b.c_int
                                       Filter: (b.c_int < 8)
(39 rows)

