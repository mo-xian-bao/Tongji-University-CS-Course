select * from
(select l_returnflag, l_shipdate, rank() over (partition by l_returnflag order by l_shipdate),
   sum(1) over (partition by l_shipdate order by l_returnflag) as rk
from vector_engine.lineitem
) as AA where AA.rk < 10 order by 1, 2, 3;
                                                                                                                                  QUERY PLAN                                                                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: aa.l_returnflag, aa.l_shipdate, aa.rank, aa.rk
   ->  Vector Sort
         Output: aa.l_returnflag, aa.l_shipdate, aa.rank, aa.rk
         Sort Key: aa.l_returnflag, aa.l_shipdate, aa.rank
         ->  Vector Subquery Scan on aa
               Output: aa.l_returnflag, aa.l_shipdate, aa.rank, aa.rk
               Filter: (aa.rk < 10)
               ->  Vector WindowAgg
                     Output: lineitem.l_returnflag, lineitem.l_shipdate, (rank() OVER (PARTITION BY lineitem.l_returnflag ORDER BY lineitem.l_shipdate USING = NULLS LAST)), sum(1) OVER (PARTITION BY lineitem.l_shipdate ORDER BY lineitem.l_returnflag USING = NULLS LAST)
                     ->  Vector Sort
                           Output: lineitem.l_returnflag, lineitem.l_shipdate, (rank() OVER (PARTITION BY lineitem.l_returnflag ORDER BY lineitem.l_shipdate USING = NULLS LAST))
                           Sort Key: lineitem.l_shipdate, lineitem.l_returnflag
                           ->  Vector WindowAgg
                                 Output: lineitem.l_returnflag, lineitem.l_shipdate, rank() OVER (PARTITION BY lineitem.l_returnflag ORDER BY lineitem.l_shipdate USING = NULLS LAST)
                                 ->  Vector Sort
                                       Output: lineitem.l_returnflag, lineitem.l_shipdate
                                       Sort Key: lineitem.l_returnflag, lineitem.l_shipdate
                                       ->  CStore Scan on vector_engine.lineitem
                                             Output: lineitem.l_returnflag, lineitem.l_shipdate
(20 rows)

create table window_t1(a int, b int) with (orientation=column);
create table window_t_rep(a int, b int) with (orientation=column)  ;
insert into window_t1 select generate_series(1,5), generate_series(1,5); 
insert into window_t_rep select generate_series(1,5), generate_series(1,5); 
analyze window_t1;
analyze window_t_rep;
-- test on multi-windowagg case
explain (costs off) select * from (select a, sum(b) over (order by a rows 2 preceding), sum(a+b) over (partition by a order by a),
sum(b) over (order by a desc rows 2 preceding), sum(a+b) over (partition by a order by a desc),
sum(b) over (order by b, a rows 2 preceding) from window_t1) t1, window_t1 t2 where t1.a=t2.a order by 1;
                                               QUERY PLAN                                               
--------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: t1.a
   ->  Hash Join
         Hash Cond: (t2.a = t1.a)
         ->  Row Adapter
               ->  CStore Scan on window_t1 t2
         ->  Hash
               ->  Subquery Scan on t1
                     ->  WindowAgg
                           ->  Sort
                                 Sort Key: window_t1.b, window_t1.a
                                 ->  WindowAgg
                                       ->  WindowAgg
                                             ->  Sort
                                                   Sort Key: window_t1.a DESC
                                                   ->  WindowAgg
                                                         ->  WindowAgg
                                                               ->  Sort
                                                                     Sort Key: window_t1.a
                                                                     ->  Row Adapter
                                                                           ->  CStore Scan on window_t1
(21 rows)

select * from (select a, sum(b) over (order by a rows 2 preceding), sum(a+b) over (partition by a order by a),
sum(b) over (order by a desc rows 2 preceding), sum(a+b) over (partition by a order by a desc),
sum(b) over (order by b, a rows 2 preceding) from window_t1) t1, window_t1 t2 where t1.a=t2.a order by 1;
 a | sum | sum | sum | sum | sum | a | b 
---+-----+-----+-----+-----+-----+---+---
 1 |   1 |   2 |   6 |   2 |   1 | 1 | 1
 2 |   3 |   4 |   9 |   4 |   3 | 2 | 2
