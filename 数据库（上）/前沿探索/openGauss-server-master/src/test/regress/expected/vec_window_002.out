select * from
(select l_returnflag, l_shipdate, rank() over (partition by l_returnflag order by l_shipdate) as rk,
   row_number() over (partition by l_returnflag order by l_shipdate) as rn
from vector_engine.lineitem
) as AA where AA.rk >= 10 order by 1, 2, 3;
                                                                                                                                    QUERY PLAN                                                                                                                                    
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: aa.l_returnflag, aa.l_shipdate, aa.rk, aa.rn
   ->  Vector Sort
         Output: aa.l_returnflag, aa.l_shipdate, aa.rk, aa.rn
         Sort Key: aa.l_returnflag, aa.l_shipdate, aa.rk
         ->  Vector Subquery Scan on aa
               Output: aa.l_returnflag, aa.l_shipdate, aa.rk, aa.rn
               Filter: (aa.rk >= 10)
               ->  Vector WindowAgg
                     Output: lineitem.l_returnflag, lineitem.l_shipdate, rank() OVER (PARTITION BY lineitem.l_returnflag ORDER BY lineitem.l_shipdate USING = NULLS LAST), row_number() OVER (PARTITION BY lineitem.l_returnflag ORDER BY lineitem.l_shipdate USING = NULLS LAST)
                     ->  Vector Sort
                           Output: lineitem.l_returnflag, lineitem.l_shipdate
                           Sort Key: lineitem.l_returnflag, lineitem.l_shipdate
                           ->  CStore Scan on vector_engine.lineitem
                                 Output: lineitem.l_returnflag, lineitem.l_shipdate
