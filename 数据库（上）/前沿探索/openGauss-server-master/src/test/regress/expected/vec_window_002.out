-- test on append case
explain (costs off) (select a, sum(b) over (order by a rows 2 preceding) from window_t1 union all
select a, sum(b) over (order by a rows 2 preceding) from window_t1) order by 1,2;
                                                                                     QUERY PLAN                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: vector_window_engine.window_t1.a, (sum(vector_window_engine.window_t1.b) OVER (ORDER BY vector_window_engine.window_t1.a USING = NULLS LAST ROWS 2::bigint PRECEDING))
   ->  Result
         ->  Append
               ->  WindowAgg
                     ->  Sort
                           Sort Key: vector_window_engine.window_t1.a
                           ->  Row Adapter
                                 ->  CStore Scan on window_t1
               ->  WindowAgg
                     ->  Sort
                           Sort Key: vector_window_engine.window_t1.a
                           ->  Row Adapter
                                 ->  CStore Scan on window_t1
(14 rows)

