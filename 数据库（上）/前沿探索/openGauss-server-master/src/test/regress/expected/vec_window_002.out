explain (verbose on, costs off)
select * from
(select l_returnflag, l_shipdate,
   sum(1) over (partition by l_returnflag order by l_returnflag) as rn,
   rank() over (partition by l_shipdate order by l_returnflag) as rk
from vector_engine.lineitem
) as AA where AA.rk < 10 order by 1, 2, 3;
                                                                                                          QUERY PLAN                                                                                                          
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Row Adapter
   Output: aa.l_returnflag, aa.l_shipdate, aa.rn, aa.rk
   ->  Vector Sort
         Output: aa.l_returnflag, aa.l_shipdate, aa.rn, aa.rk
         Sort Key: aa.l_returnflag, aa.l_shipdate, aa.rn
         ->  Vector Subquery Scan on aa
               Output: aa.l_returnflag, aa.l_shipdate, aa.rn, aa.rk
               Filter: (aa.rk < 10)
               ->  Vector WindowAgg
                     Output: lineitem.l_returnflag, lineitem.l_shipdate, (sum(1) OVER (PARTITION BY lineitem.l_returnflag)), rank() OVER (PARTITION BY lineitem.l_shipdate ORDER BY lineitem.l_returnflag USING = NULLS LAST)
                     ->  Vector Sort
                           Output: lineitem.l_returnflag, lineitem.l_shipdate, (sum(1) OVER (PARTITION BY lineitem.l_returnflag))
                           Sort Key: lineitem.l_shipdate, lineitem.l_returnflag
                           ->  Vector WindowAgg
                                 Output: lineitem.l_returnflag, lineitem.l_shipdate, sum(1) OVER (PARTITION BY lineitem.l_returnflag)
                                 ->  Vector Sort
                                       Output: lineitem.l_returnflag, lineitem.l_shipdate
                                       Sort Key: lineitem.l_returnflag
                                       ->  CStore Scan on vector_engine.lineitem
                                             Output: lineitem.l_returnflag, lineitem.l_shipdate
(20 rows)

